{
  "manifest_version": 3,
  "name": "Good Search Capture",
  "version": "0.3.0",
  "description": "Save readable articles and supported AI conversations to your local Good Search knowledge base.",
  "permissions": [
    "storage",
    "activeTab",
    "history",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:17891/*",
    "http://localhost:17891/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Good Search Capture"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "vendor/Readability.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
