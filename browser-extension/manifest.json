{
  "manifest_version": 3,
  "name": "Hydrogen Capture",
  "version": "0.3.0",
  "description": "Save readable articles and supported AI conversations to your local Hydrogen knowledge base.",
  "permissions": [
    "storage",
    "activeTab",
    "history",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:17891/*",
    "http://localhost:17891/*",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
  "gecko": {
    "id": "hydrogen-capture@oarabilekoore.github.io",
    "strict_min_version": "140.0",
    "data_collection_permissions": {
      "required": [
        "websiteContent",
        "personalCommunications",
        "browsingActivity"
      ]
    }
  }
},
    "action": {
    "default_popup": "popup.html",
    "default_title": "Hydrogen Capture"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "vendor/Readability.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
