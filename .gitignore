# ==========================================
# Rust / Cargo Build Artifacts
# ==========================================

# The main build directory containing all compiled binaries and artifacts
/target/
target
# ==========================================
# Compiler Outputs & Debugging
# ==========================================

# MSVC Windows build debugging files (large debugging info)
*.pdb

# rustc internal compiler error stack dump files
rustc-ice-*.txt

# ==========================================
# Testing & Code Quality
# ==========================================

# cargo-mutants mutation testing data
**/mutants.out*/

# Backup files generated during rustfmt formatting crashes/runs
*.rs.bk

# profiling/coverage data files generated by LLVM (e.g., cargo-tarpaulin)
*.profraw

# ==========================================
# Core Dependencies Configuration
# ==========================================

# NOTE: If your project is a library, you should NOT ignore Cargo.lock.
# If it is an binary/executable application, uncomment the line below:
# Cargo.lock

# ==========================================
# Environment / Local Secrets
# ==========================================
.env
.env*.local
